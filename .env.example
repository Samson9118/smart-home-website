# ==========================================
# БАЗОВЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ==========================================
# URL сайта (для генерации OpenGraph, sitemap.xml и ссылок в PDF-смете)
# На этапе тестов на Vercel указать домен *.vercel.app, на VPS — боевой домен
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Контактные данные компании (используются в UI и подставляются в шапку PDF-сметы)
NEXT_PUBLIC_COMPANY_NAME="SmartHome Lab"
NEXT_PUBLIC_CONTACT_PHONE="+7 (999) 000-00-00"
NEXT_PUBLIC_CONTACT_EMAIL="info@smarthome-example.ru"
NEXT_PUBLIC_TELEGRAM_USERNAME="your_smarthome_bot"
NEXT_PUBLIC_MAX_BOT_LINK="https://max.ru/your_smarthome_bot"

# ==========================================
# ИНТЕГРАЦИЯ С TELEGRAM-БОТОМ (ТОЛЬКО СЕРВЕР)
# ==========================================
# Токен бота от @BotFather (не добавлять префикс NEXT_PUBLIC_!)
TELEGRAM_BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
# ID чата или группы инженеров, куда будут приходить заявки и сметы из калькулятора
TELEGRAM_CHAT_ID=-1001234567890

# ==========================================
# ИНТЕГРАЦИЯ С MAX-БОТОМ (ТОЛЬКО СЕРВЕР)
# ==========================================
# Токен и ID чата для дублирования или отправки заявок в мессенджер MAX
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_CHAT_ID=your_max_chat_id_here

# ==========================================
# БЕЗОПАСНОСТЬ И ЗАЩИТА ОТ СПАМА
# ==========================================
# Лимит запросов с одного IP к /api/lead (количество заявок в минуту)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000