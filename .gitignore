# ==========================================
# ЗАВИСИМОСТИ И СБОРКА (NEXT.JS / NODE.JS)
# ==========================================
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Сборка Next.js и standalone-вывод
/.next/
/out/
/build/
dist/

# ==========================================
# СЕКРЕТЫ И ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ==========================================
# Исключаем все .env файлы с секретами, оставляя только шаблон .env.example
.env
.env*.local
!.env.example

# ==========================================
# ТЕСТИРОВАНИЕ (VITEST / PLAYWRIGHT)
# ==========================================
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ==========================================
# ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo
next-env.d.ts

# ==========================================
